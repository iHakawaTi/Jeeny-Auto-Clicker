# -----------------------------------------------------------------------
# Jeeny Auto-Clicker — build-time environment variables
# -----------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and fill in your own
# Supabase project's values.
#
# The app reads these at compile time via `--dart-define-from-file=.env`.
# Nothing here is a runtime config file — it's baked into the APK at build.
#
# Usage:
#   flutter run   --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# -----------------------------------------------------------------------

# Base URL of your Supabase project. Find it under Project Settings → API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon (publishable) key. Safe to embed in the client — Row Level
# Security policies (defined in supabase_schema.sql) protect the data.
# Never use the service_role key here.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
